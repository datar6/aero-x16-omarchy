[Unit]
Description=Sync GIGABYTE AERO X16 firmware power mode with the power profile
# No ordering on power-profiles-daemon: it starts after graphical.target, so
# ordering on it creates a boot cycle. The script waits for it instead.

[Service]
ExecStart=/usr/local/bin/gb-power-sync
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
